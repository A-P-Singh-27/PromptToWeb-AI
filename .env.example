# ==============================================================================
# 🚀 PromptToWeb AI - Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' in the root directory before running the application:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows PowerShell/CMD)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔑 Google Gemini API Key (REQUIRED)
# ------------------------------------------------------------------------------
# Obtain your free or paid API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
# Used by Python Agent Engine (`cursor.py`) to access Gemini models (e.g., gemini-2.0-flash, gemini-1.5-pro).
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# ⚙️ Express Backend Server Port (OPTIONAL)
# ------------------------------------------------------------------------------
# Port where the Node.js / Express backend API server listens.
# Default: 5000
PORT=5000

# ------------------------------------------------------------------------------
# 🌐 Next.js Frontend API Base URL (OPTIONAL)
# ------------------------------------------------------------------------------
# Base URL used by the Next.js client to communicate with the Express backend.
# Must include protocol and port (e.g. http://localhost:5000 for local development).
# Default: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
